{
  "openapi": "3.1.0",
  "info": {
    "title": "tenantgate control plane",
    "description": "Tenant lifecycle API for tenantgate.\n\n* Authenticate with an access token from the **system** app client (control-plane UI).\n  Tokens of tenant clients are rejected.\n* **Platform admins** (`platform-admins` group) create, list, delete tenants and change\n  their status. **Tenant admins** manage settings, members and M2M clients of their tenant.\n* All writes return `503` with `Retry-After` outside the primary Region or while\n  `auth_mode=failover`.\n",
    "version": "0.1.0"
  },
  "servers": [
    {
      "url": "/control",
      "description": "behind https://api.<domain>"
    }
  ],
  "paths": {
    "/status": {
      "get": {
        "tags": [
          "status"
        ],
        "summary": "Get Status",
        "description": "Region, Region role, degraded-mode flag and whether writes are accepted. No authentication.",
        "operationId": "get_status_status_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StatusOut"
                }
              }
            }
          }
        }
      }
    },
    "/me/tenants": {
      "get": {
        "tags": [
          "me"
        ],
        "summary": "My Tenants",
        "description": "Tenants the caller belongs to (for a \"choose workspace\" screen).",
        "operationId": "my_tenants_me_tenants_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/MyTenant"
                  },
                  "title": "Response My Tenants Me Tenants Get"
                }
              }
            }
          },
          "401": {
            "description": "Missing, invalid or expired token"
          },
          "403": {
            "description": "Wrong tenant, role or scope"
          },
          "503": {
            "description": "Signing keys temporarily unavailable; retry"
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    },
    "/tenants": {
      "post": {
        "tags": [
          "tenants"
        ],
        "summary": "Create Tenant",
        "description": "Create a tenant: app client (code + PKCE), tenant scopes, registry record, and the caller as\nits first admin. Send `Idempotency-Key` to make retries safe; a replay returns the stored\nresponse with `Idempotent-Replayed: true`.",
        "operationId": "create_tenant_tenants_post",
        "parameters": [
          {
            "name": "idempotency-key",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string",
                  "maxLength": 128
                },
                {
                  "type": "null"
                }
              ],
              "title": "Idempotency-Key"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateTenant"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TenantOut"
                }
              }
            }
          },
          "404": {
            "description": "Tenant, member or client not found (or caller is not a member)"
          },
          "409": {
            "description": "Conflicts with the current state (e.g. removing the last admin)"
          },
          "503": {
            "description": "Read-only: secondary Region, failover mode or Cognito throttling"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          },
          "401": {
            "description": "Missing, invalid or expired token"
          },
          "403": {
            "description": "Wrong tenant, role or scope"
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      },
      "get": {
        "tags": [
          "tenants"
        ],
        "summary": "List Tenants",
        "description": "List tenants, paginated with `start` (the `next` value of the previous page).",
        "operationId": "list_tenants_tenants_get",
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 100,
              "minimum": 1,
              "default": 50,
              "title": "Limit"
            }
          },
          {
            "name": "start",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Start"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TenantPage"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          },
          "401": {
            "description": "Missing, invalid or expired token"
          },
          "403": {
            "description": "Wrong tenant, role or scope"
          },
          "503": {
            "description": "Signing keys temporarily unavailable; retry"
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    },
