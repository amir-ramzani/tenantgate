  "components": {
    "schemas": {
      "AddMember": {
        "properties": {
          "email": {
            "type": "string",
            "maxLength": 254,
            "minLength": 3,
            "pattern": "^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$",
            "title": "Email"
          },
          "role": {
            "$ref": "#/components/schemas/Role",
            "default": "member"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "email"
        ],
        "title": "AddMember"
      },
      "CreateM2MClient": {
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 48,
            "minLength": 1,
            "pattern": "^[a-z0-9][a-z0-9-]*$",
            "title": "Name"
          },
          "actions": {
            "items": {
              "type": "string",
              "enum": [
                "read",
                "write"
              ]
            },
            "type": "array",
            "minItems": 1,
            "title": "Actions"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "name"
        ],
        "title": "CreateM2MClient"
      },
      "CreateTenant": {
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 100,
            "minLength": 1,
            "title": "Name"
          },
          "callback_urls": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "maxItems": 20,
            "minItems": 1,
            "title": "Callback Urls"
          },
          "logout_urls": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "maxItems": 20,
            "title": "Logout Urls"
          },
          "plan": {
