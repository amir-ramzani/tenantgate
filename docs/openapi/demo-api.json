{
  "openapi": "3.1.0",
  "info": {
    "title": "tenantgate demo API",
    "description": "Sample tenant-scoped resource server built on `authlib_mt`. Accepts user tokens (`api/read`, `api/write`) and M2M tokens (`api/tenant.<id>.read|write`). The `tenant_id` in the path must match the token. Every response carries `X-Served-Region`.",
    "version": "0.1.0"
  },
  "servers": [
    {
      "url": "/demo",
      "description": "behind https://api.<domain>"
    }
  ],
  "paths": {
    "/health": {
      "get": {
        "tags": [
          "health"
        ],
        "summary": "Health",
        "description": "Liveness and the Region that served the request. No authentication.",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "type": "object",
                  "title": "Response Health Health Get"
                }
              }
            }
          }
        }
      }
    },
    "/tenants/{tenant_id}/whoami": {
      "get": {
        "tags": [
          "identity"
        ],
        "summary": "Whoami",
        "description": "The tenant context resolved from the token: tenant, role, client and normalised scopes.",
        "operationId": "whoami_tenants__tenant_id__whoami_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WhoAmI"
                }
              }
            }
          },
          "401": {
            "description": "Missing, invalid or expired token"
          },
          "403": {
            "description": "Wrong tenant, role or scope"
          },
          "503": {
            "description": "Signing keys temporarily unavailable; retry"
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    },
    "/tenants/{tenant_id}/notes": {
      "get": {
        "tags": [
          "notes"
        ],
        "summary": "List Notes",
        "description": "List the tenant's notes. Requires `api/read`.",
        "operationId": "list_notes_tenants__tenant_id__notes_get",
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 100,
              "minimum": 1,
              "default": 50,
              "title": "Limit"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/NoteOut"
                  },
                  "title": "Response List Notes Tenants  Tenant Id  Notes Get"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          },
          "401": {
            "description": "Missing, invalid or expired token"
          },
          "403": {
            "description": "Wrong tenant, role or scope"
          },
          "503": {
            "description": "Signing keys temporarily unavailable; retry"
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      },
      "post": {
        "tags": [
          "notes"
        ],
        "summary": "Create Note",
        "description": "Create a note in the tenant's partition. Requires `api/write`.",
        "operationId": "create_note_tenants__tenant_id__notes_post",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/NoteIn"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NoteOut"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          },
          "401": {
            "description": "Missing, invalid or expired token"
          },
          "403": {
            "description": "Wrong tenant, role or scope"
          },
          "503": {
            "description": "Signing keys temporarily unavailable; retry"
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    },
    "/tenants/{tenant_id}/notes/{note_id}": {
      "get": {
        "tags": [
          "notes"
        ],
        "summary": "Get Note",
        "description": "Read a note. Requires `api/read`.",
        "operationId": "get_note_tenants__tenant_id__notes__note_id__get",
        "parameters": [
          {
            "name": "note_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Note Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NoteOut"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          },
          "401": {
            "description": "Missing, invalid or expired token"
          },
          "403": {
            "description": "Wrong tenant, role or scope"
          },
          "503": {
            "description": "Signing keys temporarily unavailable; retry"
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      },
      "put": {
        "tags": [
          "notes"
        ],
        "summary": "Update Note",
        "description": "Replace title and body. Requires `api/write`.",
        "operationId": "update_note_tenants__tenant_id__notes__note_id__put",
        "parameters": [
          {
            "name": "note_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Note Id"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/NoteIn"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NoteOut"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          },
          "401": {
            "description": "Missing, invalid or expired token"
          },
          "403": {
            "description": "Wrong tenant, role or scope"
          },
          "503": {
            "description": "Signing keys temporarily unavailable; retry"
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      },
      "delete": {
        "tags": [
          "notes"
        ],
        "summary": "Delete Note",
        "description": "Delete a note. Requires `api/write`.",
        "operationId": "delete_note_tenants__tenant_id__notes__note_id__delete",
        "parameters": [
          {
            "name": "note_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Note Id"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          },
          "401": {
            "description": "Missing, invalid or expired token"
          },
          "403": {
            "description": "Wrong tenant, role or scope"
          },
          "503": {
            "description": "Signing keys temporarily unavailable; retry"
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "NoteIn": {
        "properties": {
          "title": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1,
            "title": "Title"
          },
          "body": {
            "type": "string",
            "maxLength": 10000,
            "title": "Body",
            "default": ""
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "title"
        ],
        "title": "NoteIn"
      },
      "NoteOut": {
        "properties": {
          "note_id": {
            "type": "string",
            "title": "Note Id"
          },
          "tenant_id": {
            "type": "string",
            "title": "Tenant Id"
          },
          "title": {
            "type": "string",
            "title": "Title"
          },
          "body": {
            "type": "string",
            "title": "Body"
          },
          "author": {
            "type": "string",
            "title": "Author"
          },
          "created_at": {
            "type": "string",
            "title": "Created At"
          },
          "updated_at": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Updated At"
          }
        },
        "type": "object",
        "required": [
          "note_id",
          "tenant_id",
          "title",
          "body",
          "author",
          "created_at"
        ],
        "title": "NoteOut"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      },
      "WhoAmI": {
        "properties": {
          "tenant_id": {
            "type": "string",
            "title": "Tenant Id"
          },
          "sub": {
            "type": "string",
            "title": "Sub"
          },
          "client_id": {
            "type": "string",
            "title": "Client Id"
          },
          "role": {
            "type": "string",
            "title": "Role"
          },
          "scopes": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Scopes"
          },
          "is_m2m": {
            "type": "boolean",
            "title": "Is M2M"
          }
        },
        "type": "object",
        "required": [
          "tenant_id",
          "sub",
          "client_id",
          "role",
          "scopes",
          "is_m2m"
        ],
        "title": "WhoAmI"
      }
    },
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "Cognito access token"
      }
    }
  },
  "tags": [
    {
      "name": "health",
      "description": "Liveness and serving Region (public)"
    },
    {
      "name": "identity",
      "description": "What the token resolves to"
    },
    {
      "name": "notes",
      "description": "Tenant-partitioned notes"
    }
  ]
}
